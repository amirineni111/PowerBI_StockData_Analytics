					VAR IsModerateGrowth = RevGrowth > 0.15 && EarnGrowth > 0.15 && ROE > 0.10
					RETURN IF(IsHighGrowth, "High Growth", IF(IsModerateGrowth, "Moderate Growth", "Low Growth"))
				displayFolder: Fundamental Categories - NASDAQ
				lineageTag: 0377a224-1f3d-42a7-bc06-4799bd42cbc2

			measure 'NSE Growth Category' =
					VAR _filter = TREATAS(VALUES(nse_500[ticker]), nse_500_fundamentals[ticker])
					VAR RevGrowth = CALCULATE(MAX(nse_500_fundamentals[revenue_growth]), _filter)
					VAR EarnGrowth = CALCULATE(MAX(nse_500_fundamentals[earnings_growth]), _filter)
					VAR ROE = CALCULATE(MAX(nse_500_fundamentals[return_on_equity]), _filter)
					VAR IsHighGrowth = RevGrowth > 0.25 && EarnGrowth > 0.25 && ROE > 0.15
					VAR IsModerateGrowth = RevGrowth > 0.15 && EarnGrowth > 0.15 && ROE > 0.10
					RETURN IF(IsHighGrowth, "High Growth", IF(IsModerateGrowth, "Moderate Growth", "Low Growth"))
				displayFolder: Fundamental Categories - NSE
				lineageTag: 264cc0cc-d1fe-4c00-8a77-198da78a5a94

			measure 'NASDAQ Dividend Category' =
					VAR _filter = TREATAS(VALUES(nasdaq_top100[ticker]), nasdaq_100_fundamentals[ticker])
					VAR DivYield = CALCULATE(MAX(nasdaq_100_fundamentals[dividend_yield]), _filter)
					VAR PayoutRatio = CALCULATE(MAX(nasdaq_100_fundamentals[payout_ratio]), _filter)
					VAR FCF = CALCULATE(MAX(nasdaq_100_fundamentals[free_cashflow]), _filter)
					VAR DebtEquity = CALCULATE(MAX(nasdaq_100_fundamentals[debt_to_equity]), _filter)
					VAR IsExcellent = DivYield > 0.03 && PayoutRatio < 0.75 && FCF > 0 && DebtEquity < 1.5
					VAR IsGood = DivYield > 0.02 && PayoutRatio < 0.85 && FCF > 0
					RETURN IF(IsExcellent, "Excellent Dividend", IF(IsGood, "Good Dividend", IF(DivYield > 0, "Low Dividend", "No Dividend")))
				displayFolder: Fundamental Categories - NASDAQ
				lineageTag: f4bc377e-6824-4df8-8878-16cd781b5311

			measure 'NSE Dividend Category' =
					VAR _filter = TREATAS(VALUES(nse_500[ticker]), nse_500_fundamentals[ticker])
					VAR DivYield = CALCULATE(MAX(nse_500_fundamentals[dividend_yield]), _filter)
					VAR PayoutRatio = CALCULATE(MAX(nse_500_fundamentals[payout_ratio]), _filter)
					VAR FCF = CALCULATE(MAX(nse_500_fundamentals[free_cashflow]), _filter)
					VAR DebtEquity = CALCULATE(MAX(nse_500_fundamentals[debt_to_equity]), _filter)
					VAR IsExcellent = DivYield > 0.03 && PayoutRatio < 0.75 && FCF > 0 && DebtEquity < 1.5
					VAR IsGood = DivYield > 0.02 && PayoutRatio < 0.85 && FCF > 0
					RETURN IF(IsExcellent, "Excellent Dividend", IF(IsGood, "Good Dividend", IF(DivYield > 0, "Low Dividend", "No Dividend")))
