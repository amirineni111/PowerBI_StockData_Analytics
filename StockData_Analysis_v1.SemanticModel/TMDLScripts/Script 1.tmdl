			measure 'NASDAQ Margin Improvement' =
					VAR LatestDate = CALCULATE(MAX(nasdaq_100_fundamentals[fetch_date]), ALL(Date_tbl))
					VAR PrevDate = CALCULATE(MAX(nasdaq_100_fundamentals[fetch_date]), ALL(Date_tbl), nasdaq_100_fundamentals[fetch_date] < LatestDate)
					VAR CurrVal = CALCULATE(MAX(nasdaq_100_fundamentals[profit_margin]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(Date_tbl))
					VAR PrevVal = CALCULATE(MAX(nasdaq_100_fundamentals[profit_margin]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(Date_tbl))
					RETURN IF(ISBLANK(PrevVal) || ISBLANK(CurrVal), BLANK(), CurrVal - PrevVal)
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Turnaround Analysis - NASDAQ
				lineageTag: ta001-nasdaq-margin-improvement

