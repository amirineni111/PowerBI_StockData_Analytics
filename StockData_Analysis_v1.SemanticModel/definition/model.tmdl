model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	maxParallelismPerRefresh: 1
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["nse_500","nse_500_fundamentals","nse_500_hist_data","nasdaq_100_hist_data","nasdaq_100_fundamentals","nasdaq_top100","ml_trading_predictions","ml_technical_indicators","ml_nse_trading_predictions","ml_nse_technical_indicators","ml_nse_predict_summary","forex_ml_predictions","forex_master","forex_model_performance","forex_prediction_features","ai_prediction_history","signal_tracking_history","_Measures","vw_PowerBI_DataFreshness_strategy1","vw_PowerBI_HistoricalTrend_strategy1","vw_PowerBI_Opportunities_strategy1","vw_PowerBI_TopTickers_strategy1","vw_PowerBI_AI_Technical_Combos","nse_fair_value","nasdaq_fair_value"]

annotation PBI_ProTooling = ["DevMode"]

ref table nse_500
ref table nse_500_fundamentals
ref table nse_500_hist_data
ref table nasdaq_100_hist_data
ref table nasdaq_100_fundamentals
ref table nasdaq_top100
ref table ml_trading_predictions
ref table ml_technical_indicators
ref table ml_nse_trading_predictions
ref table ml_nse_technical_indicators
ref table ml_nse_predict_summary
ref table forex_ml_predictions
ref table forex_master
ref table forex_model_performance
ref table forex_prediction_features
ref table ai_prediction_history
ref table signal_tracking_history
ref table _Measures
ref table vw_PowerBI_DataFreshness_strategy1
ref table vw_PowerBI_HistoricalTrend_strategy1
ref table vw_PowerBI_Opportunities_strategy1
ref table vw_PowerBI_TopTickers_strategy1
ref table vw_PowerBI_AI_Technical_Combos
ref table Date_tbl
ref table nse_fair_value
ref table nasdaq_fair_value

ref cultureInfo en-US

