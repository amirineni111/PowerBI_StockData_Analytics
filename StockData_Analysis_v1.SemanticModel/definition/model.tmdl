model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	maxParallelismPerRefresh: 1
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// ALL NSE, NASDAQ and Forex technical tables here
queryGroup technical_data_tables

	annotation PBI_QueryGroupOrder = 0

/// all ML tables realte to NSE, NASDAQ and Forex
queryGroup ml_tables

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["nse_500","nse_500_fundamentals","nse_500_hist_data","nasdaq_100_hist_data","nasdaq_100_fundamentals","nasdaq_top100","ml_trading_predictions","ml_technical_indicators","ml_nse_trading_predictions","ml_nse_technical_indicators","ml_nse_predict_summary","forex_ml_predictions","forex_master","forex_model_performance","forex_prediction_features","_Measures","vw_PowerBI_DataFreshness_strategy1","vw_PowerBI_HistoricalTrend_strategy1","vw_PowerBI_Opportunities_strategy1","vw_PowerBI_TopTickers_strategy1","nse_fair_value","nasdaq_fair_value","vw_PowerBI_ValueScorePerformance","vw_PowerBI_QualityScorePerformance","vw_PowerBI_GrowthScorePerformance","vw_PowerBI_MasterScorePerformance","ai_NSE_prediction_history","ai_NASDAQ_prediction_history","ai_Forex_prediction_history","forex_hist_data","technical_nasdaq_100_atr","technical_nasdaq_100_atr_spikes","technical_nasdaq_100_bb_signals","technical_nasdaq_100_bollingerband","technical_nasdaq_100_ema_sma_view","technical_nasdaq_100_fibonacci","technical_nasdaq_100_macd","technical_nasdaq_100_macd_signals","technical_nasdaq_100_patterns","technical_nasdaq_100_RSI_calculation","technical_nasdaq_100_rsi_signals","technical_nasdaq_100_sma_signals","technical_nasdaq_100_stochastic","technical_nasdaq_100_support_resistance","technical_nse_atr","technical_nse_atr_spikes","technical_nse_bb_signals","technical_nse_bollingerband","technical_nse_ema_sma_view","technical_nse_fibonacci","technical_nse_macd","technical_nse_macd_signals","technical_nse_patterns","technical_nse_RSI_calculation","technical_nse_rsi_signals","technical_nse_sma_signals","technical_nse_stochastic","technical_nse_support_resistance","technical_forex_atr","technical_forex_atr_spikes","technical_forex_bb_signals","technical_forex_bollingerband","technical_forex_ema_sma_view","technical_forex_fibonacci","technical_forex_macd","technical_forex_macd_signals","technical_forex_patterns","technical_forex_RSI_calculation","technical_forex_rsi_signals","technical_forex_sma_signals","technical_forex_stochastic","technical_forex_support_resistance","nse_signal_tracking_history","nasdaq_signal_tracking_history","forex_signal_tracking_history","NSE_vw_PowerBI_AI_Technical_Combos","NASDAQ_vw_PowerBI_AI_Technical_Combos","Forex_vw_PowerBI_AI_Technical_Combos"]

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop","DaxQueryView_Desktop"]

