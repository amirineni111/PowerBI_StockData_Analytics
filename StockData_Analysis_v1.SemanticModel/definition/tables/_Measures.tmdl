			VAR PrevDate = CALCULATE(MAX(nasdaq_100_fundamentals[fetch_date]), ALL(nasdaq_100_fundamentals[fetch_date]), nasdaq_100_fundamentals[fetch_date] < LatestDate)
			VAR CurrVal = CALCULATE(MAX(nasdaq_100_fundamentals[revenue_growth]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR PrevVal = CALCULATE(MAX(nasdaq_100_fundamentals[revenue_growth]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			RETURN IF(ISBLANK(PrevVal) || ISBLANK(CurrVal), BLANK(), CurrVal - PrevVal)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta003-nasdaq-revenue-recovery

	measure 'NASDAQ ROE Recovery' =
			VAR LatestDate = MAX(nasdaq_100_fundamentals[fetch_date])
