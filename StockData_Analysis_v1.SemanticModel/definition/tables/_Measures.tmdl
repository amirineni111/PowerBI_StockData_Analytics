			VAR PE_Score = IF(AvgPE < 20, 50, IF(AvgPE < 35, 30, 0))
			VAR AvgPB = [NASDAQ Avg PB]
			VAR PB_Score = IF(AvgPB < 3, 50, IF(AvgPB < 6, 30, 0))
