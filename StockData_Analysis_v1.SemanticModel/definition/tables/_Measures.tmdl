	measure 'NASDAQ Growth Score' =
			VAR _filter = TREATAS(VALUES(nasdaq_top100[ticker]), nasdaq_100_fundamentals[ticker])
			VAR RevGrowth = CALCULATE(MAX(nasdaq_100_fundamentals[revenue_growth]), _filter)
			VAR EarnGrowth = CALCULATE(MAX(nasdaq_100_fundamentals[earnings_growth]), _filter)
			VAR FwdPE = CALCULATE(MAX(nasdaq_100_fundamentals[forward_pe]), _filter)
			VAR TrailPE = CALCULATE(MAX(nasdaq_100_fundamentals[trailing_pe]), _filter)
			VAR PEG = CALCULATE(MAX(nasdaq_100_fundamentals[peg_ratio]), _filter)
			VAR ROE = CALCULATE(MAX(nasdaq_100_fundamentals[return_on_equity]), _filter)
			VAR ProfitMargin = CALCULATE(MAX(nasdaq_100_fundamentals[profit_margin]), _filter)
			VAR RevGrowth_Score = IF(ISBLANK(RevGrowth), 0, IF(RevGrowth > 0.50, 30, IF(RevGrowth > 0.30, 25, IF(RevGrowth > 0.15, 20, IF(RevGrowth > 0.10, 10, IF(RevGrowth > 0, 5, 0))))))
			VAR EarnGrowth_Score = IF(ISBLANK(EarnGrowth), 0, IF(EarnGrowth > 0.50, 30, IF(EarnGrowth > 0.30, 25, IF(EarnGrowth > 0.15, 20, IF(EarnGrowth > 0.10, 10, IF(EarnGrowth > 0, 5, 0))))))
			VAR PEG_Score = IF(ISBLANK(PEG) || PEG <= 0, 0, IF(PEG < 1, 20, IF(PEG < 1.5, 15, IF(PEG < 2, 10, IF(PEG < 3, 5, 0)))))
			VAR ROE_Score = IF(ISBLANK(ROE), 0, IF(ROE > 0.20, 20, IF(ROE > 0.15, 15, IF(ROE > 0.10, 10, 0))))
			RETURN RevGrowth_Score + EarnGrowth_Score + PEG_Score + ROE_Score
		formatString: 0
		displayFolder: Fundamental Categories - NASDAQ
		lineageTag: 6eb560be-0723-4693-bdf3-e3134ae05dac

	measure 'NSE Growth Score' =
			VAR _filter = TREATAS(VALUES(nse_500[ticker]), nse_500_fundamentals[ticker])
			VAR RevGrowth = CALCULATE(MAX(nse_500_fundamentals[revenue_growth]), _filter)
