		displayFolder: Turnaround Analysis - NSE
		lineageTag: 5faa0d42-dd50-4ec4-a47a-8a083dce44c2

	/// Returns 1 when the row's fetch_date equals the latest available date for the ticker (NSE)
	measure 'NSE Is Latest Fund Date' = IF(MAX(nse_500_fundamentals[fetch_date]) = CALCULATE(MAX(nse_500_fundamentals[fetch_date]), ALL(nse_500_fundamentals[fetch_date])), 1, BLANK())
		formatString: 0
		displayFolder: Turnaround Analysis - NSE
		lineageTag: ta012-nse-is-latest-fund-date

