		formatString: 0
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta012-nasdaq-is-latest-fund-date

	/// 52-week max high_price for the ticker relative to the selected trading date
	measure 'NSE 52W High Ref' =
			VAR _ticker = MAX(nse_500_hist_data[ticker])
			VAR _selDate = MAX(nse_500_hist_data[trading_date])
			RETURN
			CALCULATE(
				MAX(nse_500_hist_data[high_price]),
				FILTER(
					ALL(nse_500_hist_data),
					nse_500_hist_data[ticker] = _ticker &&
					nse_500_hist_data[trading_date] >= _selDate - 365 &&
					nse_500_hist_data[trading_date] <= _selDate
				)
			)
		formatString: #,##0.00
		displayFolder: 52W Lifetime HighLow
		lineageTag: hl001-nse-52w-high-ref

	/// 52-week min low_price for the ticker relative to the selected trading date
