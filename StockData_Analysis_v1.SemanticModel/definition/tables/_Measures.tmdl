	/// Returns 1 if stock touched or closed at 52-week high on the selected day, BLANK otherwise
	measure 'NSE Is 52W High' =
			VAR _ticker = MAX(nse_500_hist_data[ticker])
			VAR _selDate = MAX(nse_500_hist_data[trading_date])
			VAR _dayHigh = MAX(nse_500_hist_data[high_price])
			VAR _dayClose = MAX(nse_500_hist_data[close_price])
			VAR _52wHigh = CALCULATE(MAX(nse_500_hist_data[high_price]), FILTER(ALL(nse_500_hist_data), nse_500_hist_data[ticker] = _ticker && nse_500_hist_data[trading_date] >= _selDate - 365 && nse_500_hist_data[trading_date] <= _selDate))
			VAR _52wCloseHigh = CALCULATE(MAX(nse_500_hist_data[close_price]), FILTER(ALL(nse_500_hist_data), nse_500_hist_data[ticker] = _ticker && nse_500_hist_data[trading_date] >= _selDate - 365 && nse_500_hist_data[trading_date] <= _selDate))
			RETURN IF(_dayHigh >= _52wHigh || _dayClose >= _52wCloseHigh, 1, BLANK())
		formatString: 0
		displayFolder: 52W Lifetime HighLow
		lineageTag: hl005-nse-is-52w-high

