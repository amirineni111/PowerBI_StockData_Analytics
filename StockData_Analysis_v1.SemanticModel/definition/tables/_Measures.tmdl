			VAR IsExcellent = ROE > 0.25 && ProfitMargin > 0.20 && DebtEquity < 0.3 && FCF > 0
			VAR IsGood = ROE > 0.20 && ProfitMargin > 0.15 && DebtEquity < 0.5 && FCF > 0
