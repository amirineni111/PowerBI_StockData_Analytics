	measure 'NSE 52W High' =
			CALCULATE(
				MAX(nse_500_hist_data[close_price]),
				FILTER(
					ALL(nse_500_hist_data[trading_date]),
					nse_500_hist_data[trading_date] >= TODAY() - 365
				)
			)
		formatString: 0.00
		displayFolder: NSE Historical
		lineageTag: m130-nse-52w-high

	measure 'NSE 52W Low' =
			CALCULATE(
				MIN(nse_500_hist_data[close_price]),
				FILTER(
					ALL(nse_500_hist_data[trading_date]),
					nse_500_hist_data[trading_date] >= TODAY() - 365
				)
			)
		formatString: #,##0.00
		displayFolder: NSE Historical
		lineageTag: m131-nse-52w-low

	measure 'NSE All Time High' = CALCULATE(MAX(nse_500_hist_data[close_price]), ALL(nse_500_hist_data[trading_date]))
