	measure 'NASDAQ GARP Score' =
			VAR _filter = TREATAS(VALUES(nasdaq_top100[ticker]), nasdaq_100_fundamentals[ticker])
			VAR PE = CALCULATE(MAX(nasdaq_100_fundamentals[trailing_pe]), _filter)
			VAR PB = CALCULATE(MAX(nasdaq_100_fundamentals[price_to_book]), _filter)
			VAR PEG = CALCULATE(MAX(nasdaq_100_fundamentals[peg_ratio]), _filter)
			VAR RevGrowth = CALCULATE(MAX(nasdaq_100_fundamentals[revenue_growth]), _filter)
			VAR EarnGrowth = CALCULATE(MAX(nasdaq_100_fundamentals[earnings_growth]), _filter)
			VAR ROE = CALCULATE(MAX(nasdaq_100_fundamentals[return_on_equity]), _filter)
			VAR DebtEquity = CALCULATE(MAX(nasdaq_100_fundamentals[debt_to_equity]), _filter)
			VAR Value_Score = IF(ISBLANK(PE) || PE <= 0, 0, IF(PE < 15, 15, IF(PE < 20, 10, IF(PE < 25, 5, 0)))) + IF(ISBLANK(PB) || PB <= 0, 0, IF(PB < 1.5, 15, IF(PB < 2, 10, IF(PB < 3, 5, 0)))) + IF(ISBLANK(PEG) || PEG <= 0, 0, IF(PEG < 1, 10, IF(PEG < 1.5, 7, IF(PEG < 2, 3, 0))))
			VAR Growth_Score = IF(ISBLANK(RevGrowth), 0, IF(RevGrowth > 0.20, 15, IF(RevGrowth > 0.10, 10, IF(RevGrowth > 0, 5, 0)))) + IF(ISBLANK(EarnGrowth), 0, IF(EarnGrowth > 0.20, 15, IF(EarnGrowth > 0.10, 10, IF(EarnGrowth > 0, 5, 0))))
			VAR Quality_Score = IF(ISBLANK(ROE), 0, IF(ROE > 0.20, 10, IF(ROE > 0.15, 7, IF(ROE > 0.10, 4, 0)))) + IF(ISBLANK(DebtEquity), 5, IF(DebtEquity < 0.5, 10, IF(DebtEquity < 1, 7, IF(DebtEquity < 1.5, 3, 0))))
			VAR Momentum_Score = 0
			RETURN Value_Score + Growth_Score + Quality_Score + Momentum_Score
		formatString: 0
		displayFolder: GARP Strategy - NASDAQ
		lineageTag: c4575976-6374-47c2-90d5-6fb05f8fa14b

