	measure 'NSE Turnaround Score' =
			VAR LatestDate = MAX(nse_500_fundamentals[fetch_date])
			VAR PrevDate = CALCULATE(MAX(nse_500_fundamentals[fetch_date]), ALL(nse_500_fundamentals[fetch_date]), nse_500_fundamentals[fetch_date] < LatestDate)
			VAR CurrMargin = CALCULATE(MAX(nse_500_fundamentals[profit_margin]), nse_500_fundamentals[fetch_date] = LatestDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR PrevMargin = CALCULATE(MAX(nse_500_fundamentals[profit_margin]), nse_500_fundamentals[fetch_date] = PrevDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR CurrEarnG = CALCULATE(MAX(nse_500_fundamentals[earnings_growth]), nse_500_fundamentals[fetch_date] = LatestDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR PrevEarnG = CALCULATE(MAX(nse_500_fundamentals[earnings_growth]), nse_500_fundamentals[fetch_date] = PrevDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR CurrRevG = CALCULATE(MAX(nse_500_fundamentals[revenue_growth]), nse_500_fundamentals[fetch_date] = LatestDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR PrevRevG = CALCULATE(MAX(nse_500_fundamentals[revenue_growth]), nse_500_fundamentals[fetch_date] = PrevDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR CurrROE = CALCULATE(MAX(nse_500_fundamentals[return_on_equity]), nse_500_fundamentals[fetch_date] = LatestDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR PrevROE = CALCULATE(MAX(nse_500_fundamentals[return_on_equity]), nse_500_fundamentals[fetch_date] = PrevDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR CurrDebt = CALCULATE(MAX(nse_500_fundamentals[debt_to_equity]), nse_500_fundamentals[fetch_date] = LatestDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR PrevDebt = CALCULATE(MAX(nse_500_fundamentals[debt_to_equity]), nse_500_fundamentals[fetch_date] = PrevDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR CurrFCF = CALCULATE(MAX(nse_500_fundamentals[free_cashflow]), nse_500_fundamentals[fetch_date] = LatestDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR PrevFCF = CALCULATE(MAX(nse_500_fundamentals[free_cashflow]), nse_500_fundamentals[fetch_date] = PrevDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR CurrFwdPE = CALCULATE(MAX(nse_500_fundamentals[forward_pe]), nse_500_fundamentals[fetch_date] = LatestDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR CurrTrailPE = CALCULATE(MAX(nse_500_fundamentals[trailing_pe]), nse_500_fundamentals[fetch_date] = LatestDate, ALL(nse_500_fundamentals[fetch_date]))
			VAR MarginScore = IF(ISBLANK(PrevMargin) || ISBLANK(CurrMargin), 0, IF(PrevMargin < 0 && CurrMargin > 0, 15, IF(CurrMargin > PrevMargin && CurrMargin - PrevMargin > 0.05, 12, IF(CurrMargin > PrevMargin, 6, 0))))
			VAR EarnScore = IF(ISBLANK(PrevEarnG) || ISBLANK(CurrEarnG), 0, IF(PrevEarnG < 0 && CurrEarnG > 0, 15, IF(CurrEarnG > PrevEarnG && CurrEarnG - PrevEarnG > 0.10, 12, IF(CurrEarnG > PrevEarnG, 6, 0))))
			VAR RevScore = IF(ISBLANK(PrevRevG) || ISBLANK(CurrRevG), 0, IF(PrevRevG < 0 && CurrRevG > 0, 15, IF(CurrRevG > PrevRevG && CurrRevG - PrevRevG > 0.10, 12, IF(CurrRevG > PrevRevG, 6, 0))))
			VAR ROEScore = IF(ISBLANK(PrevROE) || ISBLANK(CurrROE), 0, IF(PrevROE < 0 && CurrROE > 0, 15, IF(CurrROE > PrevROE && CurrROE - PrevROE > 0.05, 12, IF(CurrROE > PrevROE, 6, 0))))
			VAR DebtScore = IF(ISBLANK(PrevDebt) || ISBLANK(CurrDebt), 0, IF(CurrDebt < PrevDebt && PrevDebt - CurrDebt > 0.3, 15, IF(CurrDebt < PrevDebt, 8, 0)))
			VAR FCFScore = IF(ISBLANK(PrevFCF) || ISBLANK(CurrFCF), 0, IF(PrevFCF <= 0 && CurrFCF > 0, 15, IF(CurrFCF > PrevFCF, 8, 0)))
			VAR PEScore = IF(ISBLANK(CurrFwdPE) || ISBLANK(CurrTrailPE) || CurrFwdPE <= 0 || CurrTrailPE <= 0, 0, IF(CurrFwdPE < CurrTrailPE * 0.8, 10, IF(CurrFwdPE < CurrTrailPE, 5, 0)))
			RETURN MarginScore + EarnScore + RevScore + ROEScore + DebtScore + FCFScore + PEScore
		formatString: 0
		displayFolder: Turnaround Analysis - NSE
		lineageTag: ta008-nse-turnaround-score

	measure 'NSE Turnaround Signal' =
			VAR Score = [NSE Turnaround Score]
			RETURN IF(Score >= 70, "Strong Turnaround", IF(Score >= 45, "Early Turnaround", IF(Score >= 25, "Stabilizing", "No Turnaround")))
		displayFolder: Turnaround Analysis - NSE
		lineageTag: ta009-nse-turnaround-signal

	measure 'NSE Turnaround Count' =
			COUNTROWS(
				FILTER(
					VALUES(nse_500_fundamentals[ticker]),
					CALCULATE([NSE Turnaround Score]) >= 45
				)
			)
		formatString: 0
		displayFolder: Turnaround Analysis - NSE
		lineageTag: ta010-nse-turnaround-count

	measure 'NSE Strong Turnaround Count' =
			COUNTROWS(
				FILTER(
					VALUES(nse_500_fundamentals[ticker]),
					CALCULATE([NSE Turnaround Score]) >= 70
				)
			)
		formatString: 0
		displayFolder: Turnaround Analysis - NSE
		lineageTag: ta011-nse-strong-turnaround-count

	measure 'NASDAQ_Show Selected Ticker' =
			
			VAR _ticker = SELECTEDVALUE(nasdaq_top100[ticker])
			RETURN
			IF(MAX(nasdaq_100_fundamentals[ticker]) = _ticker,1,0)
		formatString: 0
		displayFolder: Fundamental Categories - NASDAQ
		lineageTag: 77bea8b8-b6e2-4e87-9947-ee84ef6a5548

	measure 'NSE_Show Selected Ticker' =
			VAR _ticker = SELECTEDVALUE(nse_500[ticker])
			RETURN
			IF(MAX(nse_500_fundamentals[ticker]) = _ticker, 1, 0)
		formatString: 0
		displayFolder: Fundamental Categories - NSE
		lineageTag: 88cea9c9-c7f3-5f98-a058-ff95fg7b6659

	measure 'NASDAQ PE Rerating %' =
			
			VAR LatestDate =
			    CALCULATE(MAX(nasdaq_100_fundamentals[fetch_date]), ALL(nasdaq_100_fundamentals[fetch_date]))
			
			VAR PrevDate =
			    CALCULATE(
			        MAX(nasdaq_100_fundamentals[fetch_date]),
			        FILTER(
			            ALL(nasdaq_100_fundamentals),
			            nasdaq_100_fundamentals[fetch_date] < LatestDate
			        )
			    )
			
			VAR CurrentPE =
			    CALCULATE(
			        MAX(nasdaq_100_fundamentals[trailing_pe]),
			        nasdaq_100_fundamentals[fetch_date] = LatestDate
			    )
			
			VAR PreviousPE =
			    CALCULATE(
			        MAX(nasdaq_100_fundamentals[trailing_pe]),
			        nasdaq_100_fundamentals[fetch_date] = PrevDate
			    )
			
			RETURN
			IF(
			    ISBLANK(CurrentPE) || ISBLANK(PreviousPE) || PreviousPE <= 0,
			    BLANK(),
			    (CurrentPE - PreviousPE) / PreviousPE
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: f266f308-27fb-4b3f-b8a0-c5c9d037adbf

	measure 'NSE PE Rerating %' =
			
