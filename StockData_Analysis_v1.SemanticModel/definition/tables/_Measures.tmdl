	measure 'NASDAQ Margin Improvement' =
			VAR LatestDate = MAX(nasdaq_100_fundamentals[fetch_date])
			VAR PrevDate = CALCULATE(MAX(nasdaq_100_fundamentals[fetch_date]), ALL(nasdaq_100_fundamentals[fetch_date]), nasdaq_100_fundamentals[fetch_date] < LatestDate)
			VAR CurrVal = CALCULATE(MAX(nasdaq_100_fundamentals[profit_margin]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR PrevVal = CALCULATE(MAX(nasdaq_100_fundamentals[profit_margin]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			RETURN IF(ISBLANK(PrevVal) || ISBLANK(CurrVal), BLANK(), CurrVal - PrevVal)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta001-nasdaq-margin-improvement

	measure 'NASDAQ Earnings Recovery' =
			VAR LatestDate = MAX(nasdaq_100_fundamentals[fetch_date])
			VAR PrevDate = CALCULATE(MAX(nasdaq_100_fundamentals[fetch_date]), ALL(nasdaq_100_fundamentals[fetch_date]), nasdaq_100_fundamentals[fetch_date] < LatestDate)
			VAR CurrVal = CALCULATE(MAX(nasdaq_100_fundamentals[earnings_growth]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR PrevVal = CALCULATE(MAX(nasdaq_100_fundamentals[earnings_growth]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			RETURN IF(ISBLANK(PrevVal) || ISBLANK(CurrVal), BLANK(), CurrVal - PrevVal)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta002-nasdaq-earnings-recovery

