	measure 'NASDAQ Value Score' =
			VAR _filter = TREATAS(VALUES(nasdaq_top100[ticker]), nasdaq_100_fundamentals[ticker])
			VAR PE = CALCULATE(MAX(nasdaq_100_fundamentals[trailing_pe]), _filter)
			VAR PB = CALCULATE(MAX(nasdaq_100_fundamentals[price_to_book]), _filter)
			VAR PS = CALCULATE(MAX(nasdaq_100_fundamentals[price_to_sales]), _filter)
			VAR PEG = CALCULATE(MAX(nasdaq_100_fundamentals[peg_ratio]), _filter)
			VAR ROE = CALCULATE(MAX(nasdaq_100_fundamentals[return_on_equity]), _filter)
			VAR PE_Score = IF(ISBLANK(PE) || PE <= 0, 0, IF(PE < 10, 25, IF(PE < 15, 20, IF(PE < 20, 15, IF(PE < 30, 5, 0)))))
			VAR PB_Score = IF(ISBLANK(PB) || PB <= 0, 0, IF(PB < 1, 25, IF(PB < 1.5, 20, IF(PB < 2, 15, IF(PB < 3, 5, 0)))))
			VAR PS_Score = IF(ISBLANK(PS) || PS <= 0, 0, IF(PS < 1, 20, IF(PS < 2, 15, IF(PS < 3, 10, IF(PS < 5, 5, 0)))))
			VAR PEG_Score = IF(ISBLANK(PEG) || PEG <= 0, 0, IF(PEG < 0.5, 15, IF(PEG < 1, 12, IF(PEG < 1.5, 8, IF(PEG < 2, 4, 0)))))
			VAR ROE_Score = IF(ISBLANK(ROE), 0, IF(ROE > 0.25, 15, IF(ROE > 0.20, 12, IF(ROE > 0.15, 8, IF(ROE > 0.10, 4, 0)))))
			RETURN PE_Score + PB_Score + PS_Score + PEG_Score + ROE_Score
		formatString: 0
		displayFolder: Fundamental Scores - NASDAQ
		lineageTag: fc760f36-6f4b-49cc-a6a8-68d682d648df

	measure 'NSE Value Score' =
			VAR _filter = TREATAS(VALUES(nse_500[ticker]), nse_500_fundamentals[ticker])
			VAR PE = CALCULATE(MAX(nse_500_fundamentals[trailing_pe]), _filter)
			VAR PB = CALCULATE(MAX(nse_500_fundamentals[price_to_book]), _filter)
			VAR PS = CALCULATE(MAX(nse_500_fundamentals[price_to_sales]), _filter)
			VAR PEG = CALCULATE(MAX(nse_500_fundamentals[peg_ratio]), _filter)
			VAR ROE = CALCULATE(MAX(nse_500_fundamentals[return_on_equity]), _filter)
			VAR PE_Score = IF(ISBLANK(PE) || PE <= 0, 0, IF(PE < 10, 25, IF(PE < 15, 20, IF(PE < 20, 15, IF(PE < 30, 5, 0)))))
			VAR PB_Score = IF(ISBLANK(PB) || PB <= 0, 0, IF(PB < 1, 25, IF(PB < 1.5, 20, IF(PB < 2, 15, IF(PB < 3, 5, 0)))))
			VAR PS_Score = IF(ISBLANK(PS) || PS <= 0, 0, IF(PS < 1, 20, IF(PS < 2, 15, IF(PS < 3, 10, IF(PS < 5, 5, 0)))))
			VAR PEG_Score = IF(ISBLANK(PEG) || PEG <= 0, 0, IF(PEG < 0.5, 15, IF(PEG < 1, 12, IF(PEG < 1.5, 8, IF(PEG < 2, 4, 0)))))
			VAR ROE_Score = IF(ISBLANK(ROE), 0, IF(ROE > 0.25, 15, IF(ROE > 0.20, 12, IF(ROE > 0.15, 8, IF(ROE > 0.10, 4, 0)))))
			RETURN PE_Score + PB_Score + PS_Score + PEG_Score + ROE_Score
		formatString: 0
		displayFolder: Fundamental Scores - NSE
		lineageTag: ad2b3ccd-2350-4217-ba9d-9d57d72dea78

	measure 'NASDAQ Quality Score' =
			VAR _filter = TREATAS(VALUES(nasdaq_top100[ticker]), nasdaq_100_fundamentals[ticker])
			VAR ROE = CALCULATE(MAX(nasdaq_100_fundamentals[return_on_equity]), _filter)
			VAR ROA = CALCULATE(MAX(nasdaq_100_fundamentals[return_on_assets]), _filter)
			VAR ProfitMargin = CALCULATE(MAX(nasdaq_100_fundamentals[profit_margin]), _filter)
			VAR OpMargin = CALCULATE(MAX(nasdaq_100_fundamentals[operating_margin]), _filter)
			VAR DebtEquity = CALCULATE(MAX(nasdaq_100_fundamentals[debt_to_equity]), _filter)
			VAR FCF = CALCULATE(MAX(nasdaq_100_fundamentals[free_cashflow]), _filter)
			VAR CurrentRatio = CALCULATE(MAX(nasdaq_100_fundamentals[current_ratio]), _filter)
			VAR ROE_Score = IF(ISBLANK(ROE), 0, IF(ROE > 0.30, 25, IF(ROE > 0.20, 20, IF(ROE > 0.15, 15, IF(ROE > 0.10, 8, 0)))))
			VAR ROA_Score = IF(ISBLANK(ROA), 0, IF(ROA > 0.15, 15, IF(ROA > 0.10, 12, IF(ROA > 0.05, 8, 0))))
			VAR Margin_Score = IF(ISBLANK(ProfitMargin), 0, IF(ProfitMargin > 0.25, 20, IF(ProfitMargin > 0.15, 15, IF(ProfitMargin > 0.10, 10, IF(ProfitMargin > 0.05, 5, 0)))))
			VAR Debt_Score = IF(ISBLANK(DebtEquity), 10, IF(DebtEquity < 0.3, 20, IF(DebtEquity < 0.5, 15, IF(DebtEquity < 1, 10, IF(DebtEquity < 1.5, 5, 0)))))
			VAR FCF_Score = IF(ISBLANK(FCF) || FCF <= 0, 0, 20)
			RETURN ROE_Score + ROA_Score + Margin_Score + Debt_Score + FCF_Score
		formatString: 0
		displayFolder: Fundamental Categories - NASDAQ
		lineageTag: 022f782d-95ef-4e22-9055-b455d8928f5e

