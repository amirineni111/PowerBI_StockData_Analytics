			VAR _selDate = MAX(nasdaq_100_hist_data[trading_date])
			VAR _dayLow = MIN(nasdaq_100_hist_data[low_price])
			VAR _dayClose = MAX(nasdaq_100_hist_data[close_price])
			VAR _ltLow = CALCULATE(MIN(nasdaq_100_hist_data[low_price]), FILTER(ALL(nasdaq_100_hist_data), nasdaq_100_hist_data[ticker] = _ticker && nasdaq_100_hist_data[trading_date] <= _selDate))
			VAR _ltCloseLow = CALCULATE(MIN(nasdaq_100_hist_data[close_price]), FILTER(ALL(nasdaq_100_hist_data), nasdaq_100_hist_data[ticker] = _ticker && nasdaq_100_hist_data[trading_date] <= _selDate))
			RETURN IF(_dayLow <= _ltLow || _dayClose <= _ltCloseLow, 1, BLANK())
		formatString: 0
		displayFolder: 52W Lifetime HighLow
		lineageTag: hl016-nasdaq-is-lt-low

	measure 'Price Move Start Date' =
			VAR _ticker = SELECTEDVALUE(Price_Movement[ticker])
			VAR _market = SELECTEDVALUE(Price_Movement[market])
			RETURN
			MINX(
				FILTER(
					ALLSELECTED(Price_Movement),
					Price_Movement[ticker] = _ticker &&
					Price_Movement[market] = _market &&
					NOT ISBLANK(Price_Movement[close_price])
				),
				Price_Movement[trading_date]
			)
		formatString: mm/dd/yyyy
		displayFolder: Price Movement
		lineageTag: pm001-start-date

	measure 'Price Move End Date' =
			VAR _ticker = SELECTEDVALUE(Price_Movement[ticker])
			VAR _market = SELECTEDVALUE(Price_Movement[market])
			RETURN
			MAXX(
				FILTER(
					ALLSELECTED(Price_Movement),
					Price_Movement[ticker] = _ticker &&
					Price_Movement[market] = _market &&
					NOT ISBLANK(Price_Movement[close_price])
				),
				Price_Movement[trading_date]
			)
		formatString: mm/dd/yyyy
		displayFolder: Price Movement
		lineageTag: pm002-end-date

	measure 'Price Move Start Price' =
			VAR _ticker = SELECTEDVALUE(Price_Movement[ticker])
			VAR _market = SELECTEDVALUE(Price_Movement[market])
			RETURN
			MAXX(
				TOPN(
					1,
					FILTER(
						ALLSELECTED(Price_Movement),
						Price_Movement[ticker] = _ticker &&
						Price_Movement[market] = _market &&
						NOT ISBLANK(Price_Movement[close_price])
					),
					Price_Movement[trading_date], ASC
				),
				Price_Movement[close_price]
			)
		formatString: #,##0.00
		displayFolder: Price Movement
		lineageTag: pm003-start-price

	measure 'Price Move End Price' =
			VAR _ticker = SELECTEDVALUE(Price_Movement[ticker])
			VAR _market = SELECTEDVALUE(Price_Movement[market])
			RETURN
			MAXX(
				TOPN(
					1,
					FILTER(
						ALLSELECTED(Price_Movement),
						Price_Movement[ticker] = _ticker &&
						Price_Movement[market] = _market &&
						NOT ISBLANK(Price_Movement[close_price])
					),
					Price_Movement[trading_date], DESC
				),
				Price_Movement[close_price]
			)
		formatString: #,##0.00
		displayFolder: Price Movement
		lineageTag: pm004-end-price

	measure 'Price Move Change' =
			[Price Move End Price] - [Price Move Start Price]
		formatString: #,##0.00
		displayFolder: Price Movement
		lineageTag: pm005-change

	measure 'Price Move Growth %' =
			DIVIDE([Price Move End Price] - [Price Move Start Price], [Price Move Start Price])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Price Movement
		lineageTag: pm006-growth-pct

	measure 'Price Move Direction' =
			VAR _growth = [Price Move Growth %]
			RETURN IF(ISBLANK(_growth), BLANK(), IF(_growth > 0, "Growth", IF(_growth < 0, "Down", "Flat")))
		displayFolder: Price Movement
		lineageTag: pm007-direction

	measure 'Price Move Meets Growth Filter' =
			VAR _threshold = SELECTEDVALUE(Price_Movement_Growth_Filter[growth_threshold_pct], 0)
			VAR _growth = [Price Move Growth %]
			RETURN
			IF(
				ISBLANK(_growth),
				BLANK(),
				IF(
					_threshold > 0,
					IF(_growth >= _threshold, 1, BLANK()),
					IF(_threshold < 0, IF(_growth <= _threshold, 1, BLANK()), 1)
				)
			)
		formatString: 0
		displayFolder: Price Movement
		lineageTag: pm008-growth-filter

	measure 'NSE Turnaround Added Price' =
			VAR _ticker = MAX(nse_500_fundamentals[ticker])
			VAR _fetchDate = MAX(nse_500_fundamentals[fetch_date])
			RETURN
			MAXX(
				TOPN(
					1,
					FILTER(
						ALL(nse_500_hist_data),
						nse_500_hist_data[ticker] = _ticker &&
						nse_500_hist_data[trading_date] >= _fetchDate &&
						NOT ISBLANK(nse_500_hist_data[close_price])
					),
					nse_500_hist_data[trading_date], ASC
				),
				nse_500_hist_data[close_price]
			)
		formatString: #,##0.00
		displayFolder: Turnaround Analysis - NSE
		lineageTag: ta013-nse-added-price

	measure 'NSE Current Price' =
			VAR _ticker = MAX(nse_500_fundamentals[ticker])
			RETURN
			MAXX(
				TOPN(
					1,
					FILTER(
						ALL(nse_500_hist_data),
						nse_500_hist_data[ticker] = _ticker &&
						NOT ISBLANK(nse_500_hist_data[close_price])
					),
					nse_500_hist_data[trading_date], DESC
				),
				nse_500_hist_data[close_price]
			)
		formatString: #,##0.00
		displayFolder: Turnaround Analysis - NSE
		lineageTag: ta014-nse-current-price

	measure 'NSE Turnaround Price Growth %' =
			DIVIDE([NSE Current Price] - [NSE Turnaround Added Price], [NSE Turnaround Added Price])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Turnaround Analysis - NSE
		lineageTag: ta015-nse-price-growth

	measure 'NASDAQ Turnaround Added Price' =
			VAR _ticker = MAX(nasdaq_100_fundamentals[ticker])
			VAR _fetchDate = MAX(nasdaq_100_fundamentals[fetch_date])
			RETURN
			MAXX(
				TOPN(
					1,
					FILTER(
						ALL(nasdaq_100_hist_data),
						nasdaq_100_hist_data[ticker] = _ticker &&
						nasdaq_100_hist_data[trading_date] >= _fetchDate &&
						NOT ISBLANK(nasdaq_100_hist_data[close_price])
					),
					nasdaq_100_hist_data[trading_date], ASC
				),
				nasdaq_100_hist_data[close_price]
			)
		formatString: #,##0.00
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta013-nasdaq-added-price

	measure 'NASDAQ Current Price' =
			VAR _ticker = MAX(nasdaq_100_fundamentals[ticker])
			RETURN
			MAXX(
				TOPN(
					1,
					FILTER(
						ALL(nasdaq_100_hist_data),
						nasdaq_100_hist_data[ticker] = _ticker &&
						NOT ISBLANK(nasdaq_100_hist_data[close_price])
					),
					nasdaq_100_hist_data[trading_date], DESC
				),
				nasdaq_100_hist_data[close_price]
			)
		formatString: #,##0.00
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta014-nasdaq-current-price

	measure 'NASDAQ Turnaround Price Growth %' =
			DIVIDE([NASDAQ Current Price] - [NASDAQ Turnaround Added Price], [NASDAQ Turnaround Added Price])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta015-nasdaq-price-growth

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type text) meta [Serialized.Text = true]) in type table [tmp = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"tmp"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table


