			VAR CurrVal = CALCULATE(MAX(nasdaq_100_fundamentals[return_on_equity]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR PrevVal = CALCULATE(MAX(nasdaq_100_fundamentals[return_on_equity]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			RETURN IF(ISBLANK(PrevVal) || ISBLANK(CurrVal), BLANK(), CurrVal - PrevVal)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta004-nasdaq-roe-recovery

	measure 'NASDAQ Debt Improvement' =
			VAR LatestDate = MAX(nasdaq_100_fundamentals[fetch_date])
			VAR PrevDate = CALCULATE(MAX(nasdaq_100_fundamentals[fetch_date]), ALL(nasdaq_100_fundamentals[fetch_date]), nasdaq_100_fundamentals[fetch_date] < LatestDate)
			VAR CurrVal = CALCULATE(MAX(nasdaq_100_fundamentals[debt_to_equity]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR PrevVal = CALCULATE(MAX(nasdaq_100_fundamentals[debt_to_equity]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			RETURN IF(ISBLANK(PrevVal) || ISBLANK(CurrVal), BLANK(), PrevVal - CurrVal)
		formatString: 0.00
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta005-nasdaq-debt-improvement

	measure 'NASDAQ FCF Turnaround' =
			VAR LatestDate = MAX(nasdaq_100_fundamentals[fetch_date])
			VAR PrevDate = CALCULATE(MAX(nasdaq_100_fundamentals[fetch_date]), ALL(nasdaq_100_fundamentals[fetch_date]), nasdaq_100_fundamentals[fetch_date] < LatestDate)
			VAR CurrVal = CALCULATE(MAX(nasdaq_100_fundamentals[free_cashflow]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR PrevVal = CALCULATE(MAX(nasdaq_100_fundamentals[free_cashflow]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			RETURN IF(ISBLANK(PrevVal) || ISBLANK(CurrVal), BLANK(), CurrVal - PrevVal)
		formatString: #,##0
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta006-nasdaq-fcf-turnaround

	measure 'NASDAQ-Fwd vs Trailing PE Spread' =
			VAR LatestDate = MAX(nasdaq_100_fundamentals[fetch_date])
			VAR FwdPE = CALCULATE(MAX(nasdaq_100_fundamentals[forward_pe]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR TrailPE = CALCULATE(MAX(nasdaq_100_fundamentals[trailing_pe]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			RETURN IF(ISBLANK(FwdPE) || ISBLANK(TrailPE) || FwdPE <= 0 || TrailPE <= 0, BLANK(), (TrailPE - FwdPE) / TrailPE)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta007-nasdaq-pe-rerating

	measure 'NASDAQ Turnaround Score' =
			VAR LatestDate = MAX(nasdaq_100_fundamentals[fetch_date])
			VAR PrevDate = CALCULATE(MAX(nasdaq_100_fundamentals[fetch_date]), ALL(nasdaq_100_fundamentals[fetch_date]), nasdaq_100_fundamentals[fetch_date] < LatestDate)
			VAR CurrMargin = CALCULATE(MAX(nasdaq_100_fundamentals[profit_margin]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR PrevMargin = CALCULATE(MAX(nasdaq_100_fundamentals[profit_margin]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR CurrEarnG = CALCULATE(MAX(nasdaq_100_fundamentals[earnings_growth]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR PrevEarnG = CALCULATE(MAX(nasdaq_100_fundamentals[earnings_growth]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR CurrRevG = CALCULATE(MAX(nasdaq_100_fundamentals[revenue_growth]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR PrevRevG = CALCULATE(MAX(nasdaq_100_fundamentals[revenue_growth]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR CurrROE = CALCULATE(MAX(nasdaq_100_fundamentals[return_on_equity]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR PrevROE = CALCULATE(MAX(nasdaq_100_fundamentals[return_on_equity]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR CurrDebt = CALCULATE(MAX(nasdaq_100_fundamentals[debt_to_equity]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR PrevDebt = CALCULATE(MAX(nasdaq_100_fundamentals[debt_to_equity]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR CurrFCF = CALCULATE(MAX(nasdaq_100_fundamentals[free_cashflow]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR PrevFCF = CALCULATE(MAX(nasdaq_100_fundamentals[free_cashflow]), nasdaq_100_fundamentals[fetch_date] = PrevDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR CurrFwdPE = CALCULATE(MAX(nasdaq_100_fundamentals[forward_pe]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR CurrTrailPE = CALCULATE(MAX(nasdaq_100_fundamentals[trailing_pe]), nasdaq_100_fundamentals[fetch_date] = LatestDate, ALL(nasdaq_100_fundamentals[fetch_date]))
			VAR MarginScore = IF(ISBLANK(PrevMargin) || ISBLANK(CurrMargin), 0, IF(PrevMargin < 0 && CurrMargin > 0, 15, IF(CurrMargin > PrevMargin && CurrMargin - PrevMargin > 0.05, 12, IF(CurrMargin > PrevMargin, 6, 0))))
			VAR EarnScore = IF(ISBLANK(PrevEarnG) || ISBLANK(CurrEarnG), 0, IF(PrevEarnG < 0 && CurrEarnG > 0, 15, IF(CurrEarnG > PrevEarnG && CurrEarnG - PrevEarnG > 0.10, 12, IF(CurrEarnG > PrevEarnG, 6, 0))))
			VAR RevScore = IF(ISBLANK(PrevRevG) || ISBLANK(CurrRevG), 0, IF(PrevRevG < 0 && CurrRevG > 0, 15, IF(CurrRevG > PrevRevG && CurrRevG - PrevRevG > 0.10, 12, IF(CurrRevG > PrevRevG, 6, 0))))
			VAR ROEScore = IF(ISBLANK(PrevROE) || ISBLANK(CurrROE), 0, IF(PrevROE < 0 && CurrROE > 0, 15, IF(CurrROE > PrevROE && CurrROE - PrevROE > 0.05, 12, IF(CurrROE > PrevROE, 6, 0))))
			VAR DebtScore = IF(ISBLANK(PrevDebt) || ISBLANK(CurrDebt), 0, IF(CurrDebt < PrevDebt && PrevDebt - CurrDebt > 0.3, 15, IF(CurrDebt < PrevDebt, 8, 0)))
			VAR FCFScore = IF(ISBLANK(PrevFCF) || ISBLANK(CurrFCF), 0, IF(PrevFCF <= 0 && CurrFCF > 0, 15, IF(CurrFCF > PrevFCF, 8, 0)))
			VAR PEScore = IF(ISBLANK(CurrFwdPE) || ISBLANK(CurrTrailPE) || CurrFwdPE <= 0 || CurrTrailPE <= 0, 0, IF(CurrFwdPE < CurrTrailPE * 0.8, 10, IF(CurrFwdPE < CurrTrailPE, 5, 0)))
			RETURN MarginScore + EarnScore + RevScore + ROEScore + DebtScore + FCFScore + PEScore
		formatString: 0
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta008-nasdaq-turnaround-score

	measure 'NASDAQ Turnaround Signal' =
			VAR Score = [NASDAQ Turnaround Score]
			RETURN IF(Score >= 70, "Strong Turnaround", IF(Score >= 45, "Early Turnaround", IF(Score >= 25, "Stabilizing", "No Turnaround")))
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta009-nasdaq-turnaround-signal

	measure 'NASDAQ Turnaround Count' =
			COUNTROWS(
				FILTER(
					VALUES(nasdaq_100_fundamentals[ticker]),
					CALCULATE([NASDAQ Turnaround Score]) >= 45
				)
			)
		formatString: 0
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta010-nasdaq-turnaround-count

	measure 'NASDAQ Strong Turnaround Count' =
			COUNTROWS(
				FILTER(
					VALUES(nasdaq_100_fundamentals[ticker]),
					CALCULATE([NASDAQ Turnaround Score]) >= 70
				)
			)
		formatString: 0
		displayFolder: Turnaround Analysis - NASDAQ
		lineageTag: ta011-nasdaq-strong-turnaround-count

