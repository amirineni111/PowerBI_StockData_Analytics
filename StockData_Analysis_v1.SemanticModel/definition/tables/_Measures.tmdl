			VAR ProfitMargin = CALCULATE(MAX(nse_500_fundamentals[profit_margin]), _filter)
			VAR RevGrowth_Score = IF(ISBLANK(RevGrowth), 0, IF(RevGrowth > 0.50, 30, IF(RevGrowth > 0.30, 25, IF(RevGrowth > 0.15, 20, IF(RevGrowth > 0.10, 10, IF(RevGrowth > 0, 5, 0))))))
			VAR EarnGrowth_Score = IF(ISBLANK(EarnGrowth), 0, IF(EarnGrowth > 0.50, 30, IF(EarnGrowth > 0.30, 25, IF(EarnGrowth > 0.15, 20, IF(EarnGrowth > 0.10, 10, IF(EarnGrowth > 0, 5, 0))))))
			VAR PEG_Score = IF(ISBLANK(PEG) || PEG <= 0, 0, IF(PEG < 1, 20, IF(PEG < 1.5, 15, IF(PEG < 2, 10, IF(PEG < 3, 5, 0)))))
			VAR ROE_Score = IF(ISBLANK(ROE), 0, IF(ROE > 0.20, 20, IF(ROE > 0.15, 15, IF(ROE > 0.10, 10, 0))))
			RETURN RevGrowth_Score + EarnGrowth_Score + PEG_Score + ROE_Score
		formatString: 0
		displayFolder: Fundamental Scores - NSE
		lineageTag: e1421804-1975-4129-b36e-1eb114e88654

	measure 'NASDAQ Dividend Score' =
			VAR _filter = TREATAS(VALUES(nasdaq_top100[ticker]), nasdaq_100_fundamentals[ticker])
			VAR DivYield = CALCULATE(MAX(nasdaq_100_fundamentals[dividend_yield]), _filter)
