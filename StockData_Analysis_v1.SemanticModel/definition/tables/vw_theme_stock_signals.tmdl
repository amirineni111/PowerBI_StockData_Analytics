	column 'Conviction Level' =
			
			SWITCH(
			    SELECTEDVALUE(vw_theme_stock_signals[heat_label]),
			    "Hot",      "Full size",
			    "Rising",   "Standard",
			    "Emerging", "Half size",
			    "Steady",   "Watch only",
			    "Caution",  "Skip",
			    "Hold"
			)
		lineageTag: 6a96630c-6367-4c65-8328-389cf9452ff3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Conviction Color' =
			
			SWITCH(
			    SELECTEDVALUE(vw_theme_stock_signals[heat_label]),
			    "Hot",      "#1D9E75",
			    "Rising",   "#5DCAA5",
			    "Emerging", "#EF9F27",
			    "Steady",   "#888780",
			    "Caution",  "#D85A30",
			                "#888780"
			)
		lineageTag: cd6f2f47-4396-4efe-b29f-cdd55d4108bb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

