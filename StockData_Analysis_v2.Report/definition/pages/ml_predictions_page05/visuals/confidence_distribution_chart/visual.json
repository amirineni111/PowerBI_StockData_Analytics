{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.5.0/schema.json",
  "name": "confidence_distribution_chart",
  "position": {"x": 20, "y": 250, "z": 5, "height": 380, "width": 580, "tabOrder": 5},
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [{"field": {"Column": {"Expression": {"SourceRef": {"Entity": "ml_trading_predictions"}}, "Property": "signal_confidence"}}, "queryRef": "ml_trading_predictions.signal_confidence", "nativeQueryRef": "signal_confidence"}]
        },
        "Values": {
          "projections": [{"field": {"Aggregation": {"Expression": {"SourceRef": {"Entity": "ml_trading_predictions"}}, "Function": "Count"}}, "queryRef": "ml_trading_predictions.Count", "nativeQueryRef": "Count"}]
        }
      }
    },
    "objects": {"categoryAxis": [{"properties": {"showAxisTitle": {"expr": {"Literal": {"Value": "true"}}}}}]},
    "drillFilterOtherVisuals": true
  }
}
