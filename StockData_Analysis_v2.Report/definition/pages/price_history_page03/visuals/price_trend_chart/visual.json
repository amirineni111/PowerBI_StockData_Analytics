{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.5.0/schema.json",
  "name": "price_trend_chart",
  "position": {"x": 20, "y": 100, "z": 1, "height": 400, "width": 1180, "tabOrder": 1},
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [{"field": {"Column": {"Expression": {"SourceRef": {"Entity": "nse_500_hist_data"}}, "Property": "trading_date"}}, "queryRef": "nse_500_hist_data.trading_date", "nativeQueryRef": "trading_date"}]
        },
        "Y": {
          "projections": [
            {"field": {"Column": {"Expression": {"SourceRef": {"Entity": "nse_500_hist_data"}}, "Property": "close_price"}}, "queryRef": "nse_500_hist_data.close_price", "nativeQueryRef": "close_price"},
            {"field": {"Column": {"Expression": {"SourceRef": {"Entity": "nse_500_hist_data"}}, "Property": "high_price"}}, "queryRef": "nse_500_hist_data.high_price", "nativeQueryRef": "high_price"},
            {"field": {"Column": {"Expression": {"SourceRef": {"Entity": "nse_500_hist_data"}}, "Property": "low_price"}}, "queryRef": "nse_500_hist_data.low_price", "nativeQueryRef": "low_price"}
          ]
        }
      }
    },
    "objects": {"legend": [{"properties": {"show": {"expr": {"Literal": {"Value": "true"}}}}}]},
    "drillFilterOtherVisuals": true
  }
}
